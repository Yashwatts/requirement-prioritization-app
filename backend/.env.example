PORT=5000
NODE_ENV=development

# Database configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=requirement_prioritization_app
DB_SCHEMA=requirements

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

APP_NAME=requirement-prioritization-app
RABBITMQ_DSN=amqp://guest:guest@localhost:5672

# RabbitMQ Exchange and Routing Keys
RABBITMQ_EXCHANGE=requirement-prioritization.events
RABBITMQ_ROUTING_KEY_REQUIREMENT_REGISTERED=requirement-prioritization.requirement_registered
RABBITMQ_ROUTING_KEY_REQUIREMENT_CLIENT_PRIORITY_UPDATED=requirement-prioritization.requirement_client_priority_updated
RABBITMQ_ROUTING_KEY_REQUIREMENT_MANAGEMENT_PRIORITY_UPDATED=requirement-prioritization.requirement_management_priority_updated